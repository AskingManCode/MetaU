@MicroservicioMatriculas_HostAddress = https://localhost:7070
@Token = PEGAR_TOKEN_DEL_LOGIN
@UsuarioId = PEGAR_GUID_DEL_USUARIO
@MatriculaId = PEGAR_ID_DE_LA_MATRICULA

### Matricular
POST {{MicroservicioMatriculas_HostAddress}}/matricula
Authorization: Bearer {{Token}}
X-Usuario-Id: {{UsuarioId}}
Content-Type: application/json

{
  "identificacion": "123456789",
  "cursoCode": "CURSO1",
  "grupoCode": "GRUPO1",
  "observaciones": "Sin observaciones",
  "periodoID": "00000000-0000-0000-0000-000000000000"
}

### Modificar la matricula (el id lo devuelve el POST)
PUT {{MicroservicioMatriculas_HostAddress}}/matricula/{{MatriculaId}}
Authorization: Bearer {{Token}}
X-Usuario-Id: {{UsuarioId}}
Content-Type: application/json

{
  "identificacion": "123456789",
  "cursoCode": "CURSO1",
  "grupoCode": "GRUPO2",
  "observaciones": "Cambio de grupo",
  "periodoID": "00000000-0000-0000-0000-000000000000"
}

### Eliminar matricula
DELETE {{MicroservicioMatriculas_HostAddress}}/matricula/{{MatriculaId}}
Authorization: Bearer {{Token}}
X-Usuario-Id: {{UsuarioId}}

### Obtener estudiantes matriculados en un curso y grupo
GET {{MicroservicioMatriculas_HostAddress}}/matricula?cursoCode=CURSO1&grupoCode=GRUPO1
Authorization: Bearer {{Token}}
X-Usuario-Id: {{UsuarioId}}
