<mxfile host="app.diagrams.net"><diagram name="Casos de uso Gateway" id="gw-cu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;API Gateway MetaU - Diagrama de casos de uso (GTW1 y GTW2)&lt;/b&gt;" style="text;html=1;align=left;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" value="Alcance: cliente estudiante (App móvil y Web Flutter). Rutas y verbos según la matriz de enrutamiento del README del Gateway." style="text;html=1;align=left;fontSize=11;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="52" width="1000" height="24" as="geometry"/></mxCell><mxCell id="bound" value="API Gateway MetaU  (YARP · .NET 10 · puerto único)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="1020" height="1000" as="geometry"/></mxCell><mxCell id="est" value="&lt;b&gt;Estudiante&lt;/b&gt;&lt;br&gt;(App móvil / Web Flutter)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="530" width="40" height="70" as="geometry"/></mxCell><mxCell id="ms" value="&lt;b&gt;Microservicios MetaU&lt;/b&gt;&lt;br&gt;(Plesk)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1260" y="525" width="40" height="70" as="geometry"/></mxCell><mxCell id="login" value="&lt;b&gt;Microservicio Login&lt;/b&gt;&lt;br&gt;(/validate)" sty