aja = JSON eliminado; consulta = «El usuario consulta &amp;lt;elemento&amp;gt;».&lt;br&gt;• validarExistencias: el curso, el profesor y el periodo deben existir." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="900" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg3" name="Base de datos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="&lt;b style='font-size:20px'&gt;Base de datos - ACD4 Grupos&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="34" as="geometry"/></mxCell><mxCell id="GRUPO" value="GRUPO" style="swimlane;fontStyle=1;fontSize=14;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="380" height="200" as="geometry"/></mxCell><mxCell id="GRUPO_r0" value="PK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;id_grupo&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;INT" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=none;strokeColor=#82b366;fontStyle=1;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="GRUPO"><mxGeometry x="0" y="32" width="380" height="24" as="geometry"/></mxCell><mxCell id="GRUPO_r1" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;