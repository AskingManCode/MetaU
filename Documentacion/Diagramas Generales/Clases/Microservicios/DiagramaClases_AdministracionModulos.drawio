/></mxCell><mxCell id="MODULO" value="MODULO" style="swimlane;fontStyle=1;fontSize=14;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="380" height="80" as="geometry"/></mxCell><mxCell id="MODULO_r0" value="PK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;id_modulo&amp;nbsp;&amp;nbsp;INT" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=none;strokeColor=#9673a6;fontStyle=1;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="MODULO"><mxGeometry x="0" y="32" width="380" height="24" as="geometry"/></mxCell><mxCell id="MODULO_r1" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;VARCHAR(100)" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="MODULO"><mxGeometry x="0" y="56" width="380" height="24" as="geometry"/></mxCell><mxCell id="v3" value="Todos los datos son requeridos (no vacíos ni en blanco).&lt;br&gt;El nombre solo admite letras y espacios (validación en el servicio)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="460" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>