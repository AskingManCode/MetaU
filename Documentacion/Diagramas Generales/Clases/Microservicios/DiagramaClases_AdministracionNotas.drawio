        <mxCell id="laneL" parent="1" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#E6E0EC;swimlaneFillColor=#FFFFFF;strokeColor=#8064A2;fontColor=#3F3151;fontStyle=1;fontSize=13;" value="MAT5 — NOTAS" vertex="1">
