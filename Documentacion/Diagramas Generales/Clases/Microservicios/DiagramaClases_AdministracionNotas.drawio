        <mxCell id="ep" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FAF8FC;strokeColor=#8064A2;fontSize=11;" value="&lt;b&gt;NotasEndpoints&lt;/b&gt;&lt;hr&gt;+ MapearEndpoints(app)&lt;br&gt;+ cargarDesglose(dto) &amp;#160;// POST /cargardesglose&lt;br&gt;+ asignarNotaRubro(dto) &amp;#160;// POST /asignarnotarubro&lt;br&gt;+ modificarNotaRubro(dto) &amp;#160;// PUT /asignarnotarubro&lt;br&gt;+ obtenerDesglose(idGrupo) &amp;#160;// GET /obtenerdesglose&lt;br&gt;+ obtenerNotas(identificacion, idCurso) &amp;#160;// GET /obtenernotas" vertex="1">
          <mxGeometry height="132" width="350" x="60" y="100" as="geometry" />
        </mxCell>
        <mxCell id="svc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8064A2;fontSize=11;" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;INotaService&lt;/b&gt;&lt;hr&gt;+ cargarDesglose(dto): List&amp;lt;Rubro&amp;gt;&lt;br&gt;+ asignarNotaRubro(dto): NotaRubro&lt;br&gt;+ modificarNotaRubro(dto): NotaRubro&lt;br&gt;+ obtenerDesglose(idGrupo): List&amp;lt;Rubro&amp;gt;&lt;br&gt;+ obtenerNotas(identificacion, idCurso): List&amp;lt;NotaRubro&amp;gt;&lt;hr&gt;&lt;i&gt;Cargar desglose: los rubros deben sumar 100. Si el grupo ya tenía&lt;br&gt;desglose, se reemplaza por el nuevo.&lt;br&gt;No se pueden modificar los rubros una vez asignadas notas a&lt;br&gt;estudiantes.&lt;br&gt;La nota de un rubro debe estar entre 1 y 100.&lt;br&gt;Todas las operaciones exigen token válido y registran bitácora.&lt;/i&gt;" vertex="1">
          <mxGeometry height="230" width="350" x="60" y="277" as="geometry" />
        </mxCell>
        <mxCell id="repo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF9E6;strokeColor=#BF9000;fontSize=11;" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;INotaRepository&lt;/b&gt;&lt;hr&gt;+ reemplazarDesglose(idGrupo, rubros)&lt;br&gt;+ listarRubrosPorGrupo(idGrupo): List&amp;lt;Rubro&amp;gt;&lt;br&gt;+ obtenerRubro(idRubro): Rubro&lt;br&gt;+ existenNotasEnGrupo(idGrupo): bool&lt;br&gt;+ insertarNota(nota)&lt;br&gt;+ actualizarNota(nota)&lt;br&gt;+ obtenerNota(idRubro, identificacion): NotaRubro&lt;br&gt;+ listarNotas(identificacion, idCurso): List&amp;lt;NotaRubro&amp;gt;" vertex="1">
