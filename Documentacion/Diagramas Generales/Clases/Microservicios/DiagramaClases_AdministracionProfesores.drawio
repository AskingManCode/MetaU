        <mxCell id="svc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#70AD47;fontSize=11;" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;IProfesorService&lt;/b&gt;&lt;hr&gt;+ crear(dto): Profesor&lt;br&gt;+ actualizar(numeroIdentificacion, dto): Profesor&lt;br&gt;+ eliminar(numeroIdentificacion)&lt;br&gt;+ obtener(numeroIdentificacion): Profesor&lt;br&gt;+ listar(): List&amp;lt;Profesor&amp;gt;&lt;hr&gt;&lt;i&gt;Todos los datos son requeridos, sin vacíos ni espacios en blanco.&lt;br&gt;El nombre solo puede contener letras y espacios.&lt;br&gt;Debe ser mayor de edad.&lt;br&gt;Email con formato válido y del dominio cuc.ac.cr (dominio&lt;br&gt;parametrizable).&lt;br&gt;Todas las operaciones exigen token válido y registran bitácora.&lt;/i&gt;" vertex="1">
          <mxGeometry height="230" width="350" x="60" y="277" as="geometry" />
        </mxCell>
