        <mxCell id="ep" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F9FDF7;strokeColor=#70AD47;fontSize=11;" value="&lt;b&gt;ProfesorEndpoints&lt;/b&gt;&lt;hr&gt;+ MapearEndpoints(app) &amp;#160;// /profesor&lt;br&gt;+ crear(dto)&lt;br&gt;+ actualizar(numeroIdentificacion, dto)&lt;br&gt;+ eliminar(numeroIdentificacion)&lt;br&gt;+ obtener(numeroIdentificacion)&lt;br&gt;+ listar()" vertex="1">
