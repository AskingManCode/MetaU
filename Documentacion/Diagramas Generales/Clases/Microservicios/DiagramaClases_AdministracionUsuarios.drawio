        <mxCell id="ep" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F7FBFF;strokeColor=#5B9BD5;fontSize=11;" value="&lt;b&gt;UsuarioEndpoints&lt;/b&gt;&lt;hr&gt;+ MapearEndpoints(app) &amp;#160;// /usuario&lt;br&gt;+ crear(dto)&lt;br&gt;+ actualizar(email, dto)&lt;br&gt;+ eliminar(email)&lt;br&gt;+ obtener(email)&lt;br&gt;+ listar()&lt;br&gt;+ filtrar(identificacion?, nombre?, tipo?)" vertex="1">
