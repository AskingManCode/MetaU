<mxfile host="app.diagrams.net">
  <diagram id="IPN3" name="IPN3 — Gestión de notificaciones">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1226" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="laneL" parent="1" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#D6EEEE;swimlaneFillColor=#FFFFFF;strokeColor=#2A8C8C;fontColor=#17365D;fontStyle=1;fontSize=13;" value="IPN3 — NOTIFICACIONES" vertex="1"><mxGeometry height="1146" width="520" x="30" y="40" as="geometry" /></mxCell>
        <mxCell id="laneR" parent="1" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#F2F2F2;swimlaneFillColor=#FFFFFF;strokeColor=#7F8C8D;fontColor=#404040;fontStyle=1;fontSize=13;" value="DEPENDENCIAS EXTERNAS, MODELO Y CONFIGURACIÓN" vertex="1"><mxGeometry height="1146" width="900" x="580" y="40" as="geometry" /></mxCell>
                <mxCell id="ep" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F3FBFB;strokeColor=#2A8C8C;fontSize=11;" value="&amp;lt;&amp;lt;static&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;NotificacionesEndpoints&lt;/b&gt;&lt;hr&gt;+ MapNotificacionesEndpoints(app: WebApplication): void  // grupo /api/notificar, POST /&lt;br&gt;- EnviarCorreo(request: NotificarRequest, httpRequest: HttpRequest, validator: IValidator&amp;lt;NotificarRequest&amp;gt;, authServiceValidator: IAuthServiceValidator, service: INotificacionesService, bitacoraService: IBitacoraServiceClient): Task&amp;lt;IResult&amp;gt;&lt;hr&gt;&lt;i&gt;Valida token y UsuarioGUID, valida el request (FluentValidation), envía el correo y registra bitácora (un fallo de bitácora no interrumpe la operación).&lt;br&gt;Respuestas: 200 OK, 400 BadRequest, 401 Unauthorized, 500 error interno.&lt;/i&gt;" vertex="1"><mxGeometry height="216" width="460" x="60" y="90" as="geometry" /></mxCell>
        <mxCell id="isvc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#2A8C8C;fontSize=11;" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;INotificacionesService&lt;/b&gt;&lt;hr&gt;+ EnviarCorreoAsync(request: NotificarRequest, usuarioId: Guid): Task&amp;lt;NotificarResponse&amp;gt;" vertex="1"><mxGeometry height="86" width="460" x="60" y="328" as="geometry" /></mxCell>
        <mxCell id="svc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#2A8C8C;fontSize=11;" value="&lt;b&gt;NotificacionesService&lt;/b&gt;&lt;hr&gt;- _smtp: SmtpSettings&lt;br&gt;- _repository: INotificacionesRepository&lt;br&gt;+ NotificacionesService(smtpOptions: IOptions&amp;lt;SmtpSettings&amp;gt;, repository: INotificacionesRepository)&lt;br&gt;+ EnviarCorreoAsync(request: NotificarRequest, usuarioId: Guid): Task&amp;lt;NotificarResponse&amp;gt;&lt;hr&gt;&lt;i&gt;Crea la notificación en estado PENDIENTE, arma el MimeMessage (cuerpo HTML) y lo envía por SMTP con MailKit (StartTls). Actualiza el estado a ENVIADO o ERROR (mensaje truncado a 500 caracteres).&lt;/i&gt;" vertex="1"><mxGeometry height="186" width="460" x="60" y="436" as="geometry" /></mxCell>
        <mxCell id="irepo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF9E6;strokeColor=#BF9000;fontSize=11;" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;INotificacionesRepository&lt;/b&gt;&lt;hr&gt;+ CrearAsync(usuarioId: Guid, emailDestino: string, parametrosJson: string): Task&amp;lt;Notificacion&amp;gt;&lt;br&gt;+ ActualizarEstadoAsync(notificacionId: long, estado: string, mensajeError: string? = null, fechaEnvio: DateTime? = null): Task&amp;lt;Notificacion?&amp;gt;" vertex="1"><mxGeometry height="116" width="460" x="60" y="644" as="geometry" /></mxCell>
        <mxCell id="repo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF9E6;strokeColor=#BF9000;fontSize=11;" value="&lt;b&gt;NotificacionesRepository&lt;/b&gt;&lt;hr&gt;- _connectionFactory: IDBConnectionFactory&lt;br&gt;+ NotificacionesRepository(connectionFactory: IDBConnectionFactory)&lt;br&gt;+ CrearAsync(...): Task&amp;lt;Notificacion&amp;gt;  // dbo.usp_Notificaciones_Crear&lt;br&gt;+ ActualizarEstadoAsync(...): Task&amp;lt;Notificacion?&amp;gt;  // dbo.usp_Notificaciones_ActualizarEstado&lt;hr&gt;&lt;i&gt;Acceso a datos con Dapper (stored procedures). Plantilla fija &amp;#x27;CUSTOM&amp;#x27; y estado inicial &amp;#x27;PENDIENTE&amp;#x27;.&lt;/i&gt;" vertex="1"><mxGeometry height="156" width="460" x="60" y="782" as="geometry" /></mxCell>
        <mxCell id="idf" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF9E6;strokeColor=#BF9000;fontSize=11;" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;IDBConnectionFactory&lt;/b&gt;&lt;hr&gt;+ CreateConnection(): IDbConnection" vertex="1"><mxGeometry height="71" width="460" x="60" y="960" as="geometry" /></mxCell>
        <mxCell id="dbf" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF9E6;strokeColor=#BF9000;fontSize=11;" value="&lt;b&gt;DBConnectionFactory&lt;/b&gt;&lt;hr&gt;- _configuration: IConfiguration&lt;br&gt;+ DBConnectionFactory(configuration: IConfiguration)&lt;br&gt;+ CreateConnection(): IDbConnection  // SqlConnection con ConnectionStrings:DefaultConnection" vertex="1"><mxGeometry height="101" width="460" x="60" y="1053" as="geometry" /></mxCell>
        <mxCell id="iav" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;dashed=1;" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;IAuthServiceValidator&lt;/b&gt;&lt;hr&gt;+ ValidarAsync(request: HttpRequest): Task&amp;lt;(Guid Usuario, string Token, IResult? Error)&amp;gt;" vertex="1"><mxGeometry height="86" width="400" x="610" y="90" as="geometry" /></mxCell>
        <mxCell id="av" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;dashed=1;" value="&lt;b&gt;AuthServiceValidator&lt;/b&gt;&lt;hr&gt;- _authClient: IAuthServiceClient&lt;br&gt;+ ValidarAsync(request: HttpRequest): Task&amp;lt;(Guid Usuario, string Token, IResult? Error)&amp;gt;&lt;hr&gt;&lt;i&gt;Lee el header Authorization (Bearer) y UsuarioGUID; 401 si el token falta o es inválido, 400 si el usuario es inválido.&lt;/i&gt;" vertex="1"><mxGeometry height="126" width="400" x="610" y="198" as="geometry" /></mxCell>
        <mxCell id="iac" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;dashed=1;" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;IAuthServiceClient (USR5)&lt;/b&gt;&lt;hr&gt;+ ValidarTokenAsync(token: string): Task&amp;lt;bool&amp;gt;" vertex="1"><mxGeometry height="71" width="400" x="610" y="346" as="geometry" /></mxCell>
        <mxCell id="ac" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;dashed=1;" value="&lt;b&gt;AuthServiceClient&lt;/b&gt;&lt;hr&gt;- _httpClient: HttpClient&lt;br&gt;+ ValidarTokenAsync(token: string): Task&amp;lt;bool&amp;gt;  // POST /validate&lt;hr&gt;&lt;i&gt;BaseUrl: MicroservicioLogin:BaseUrl&lt;/i&gt;" vertex="1"><mxGeometry height="111" width="400" x="610" y="439" as="geometry" /></mxCell>
        <mxCell id="ibc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;dashed=1;" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;IBitacoraServiceClient (GEN1)&lt;/b&gt;&lt;hr&gt;+ RegistrarBitacoraAsync(usuario: Guid, descripcion: string, token: string): Task" vertex="1"><mxGeometry height="86" width="400" x="610" y="572" as="geometry" /></mxCell>
        <mxCell id="bc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;dashed=1;" value="&lt;b&gt;BitacoraServiceClient&lt;/b&gt;&lt;hr&gt;- _httpClient: HttpClient&lt;br&gt;+ RegistrarBitacoraAsync(usuario: Guid, descripcion: string, token: string): Task  // POST /bitacora&lt;hr&gt;&lt;i&gt;BaseUrl: MicroservicioBitacoras:BaseUrl. Envía Bearer token y header X-Usuario-Id.&lt;/i&gt;" vertex="1"><mxGeometry height="126" width="400" x="610" y="680" as="geometry" /></mxCell>
        <mxCell id="req" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;" value="&amp;lt;&amp;lt;DTO&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;NotificarRequest&lt;/b&gt;&lt;hr&gt;+ Email: string&lt;br&gt;+ Asunto: string&lt;br&gt;+ Cuerpo: string  // HTML" vertex="1"><mxGeometry height="101" width="400" x="1050" y="90" as="geometry" /></mxCell>
        <mxCell id="val" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;" value="&lt;b&gt;NotificarRequestValidator&lt;/b&gt;&lt;hr&gt;// extiende AbstractValidator&amp;lt;NotificarRequest&amp;gt;&lt;br&gt;- EmailRegex: string (const)&lt;hr&gt;&lt;i&gt;Email: obligatorio, 7 a 150 caracteres, formato válido, sin &amp;#x27;..&amp;#x27;. Asunto: obligatorio, máx. 200. Cuerpo: obligatorio.&lt;/i&gt;" vertex="1"><mxGeometry height="111" width="400" x="1050" y="213" as="geometry" /></mxCell>
        <mxCell id="resp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;" value="&amp;lt;&amp;lt;DTO&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;NotificarResponse&lt;/b&gt;&lt;hr&gt;+ Email: string&lt;br&gt;+ Asunto: string&lt;br&gt;+ Cuerpo: string&lt;br&gt;+ Estado: string  // PENDIENTE, ENVIADO, ERROR, CANCELADO&lt;br&gt;+ Mensaje: string?&lt;br&gt;+ FechaEnvio: DateTime" vertex="1"><mxGeometry height="146" width="400" x="1050" y="346" as="geometry" /></mxCell>
        <mxCell id="notif" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F2F2F2;strokeColor=#7F8C8D;fontSize=11;" value="&amp;lt;&amp;lt;Entity&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Notificacion&lt;/b&gt;&lt;hr&gt;+ NotificacionID: long&lt;br&gt;+ UsuarioID: Guid&lt;br&gt;+ EmailDestino: string&lt;br&gt;+ PlantillaNotificacionCode: string&lt;br&gt;+ ParametrosJson: string?&lt;br&gt;+ FechaCreacion: DateTime&lt;br&gt;+ FechaEnvio: DateTime?&lt;br&gt;+ EstadoNotificacion: string&lt;br&gt;+ MensajeError: string?&lt;br&gt;+ NumeroIntentos: byte&lt;br&gt;+ FechaUltimoIntento: DateTime?" vertex="1"><mxGeometry height="221" width="400" x="1050" y="514" as="geometry" /></mxCell>
        <mxCell id="smtp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F2F2F2;strokeColor=#7F8C8D;fontSize=11;" value="&amp;lt;&amp;lt;Config&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SmtpSettings&lt;/b&gt;&lt;hr&gt;+ Host: string&lt;br&gt;+ Port: int&lt;br&gt;+ User: string&lt;br&gt;+ Password: string&lt;br&gt;+ From: string&lt;br&gt;+ FromName: string&lt;br&gt;+ EnableSsl: bool = true&lt;hr&gt;&lt;i&gt;Se enlaza con la sección &amp;#x27;Smtp&amp;#x27; de appsettings.json (IOptions&amp;lt;SmtpSettings&amp;gt;).&lt;/i&gt;" vertex="1"><mxGeometry height="201" width="400" x="1050" y="757" as="geometry" /></mxCell>
