        <mxCell id="c3" parent="1" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#F2F2F2;swimlaneFillColor=#FFFFFF;strokeColor=#7F8C8D;fontColor=#404040;fontStyle=1;fontSize=13;" value="CLASES DEL DOMINIO Y DEPENDENCIAS" vertex="1"><mxGeometry x="510" y="50" width="880" height="714" as="geometry"/></mxCell>
        <mxCell id="u5_ep" parent="1" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F7FBFF;strokeColor=#5B9BD5;fontSize=11;" value="&lt;b&gt;LoginEndpoints&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ MapearEndpoints(app)&lt;br&gt;+ login(usuario, contraseña)   // POST /login&lt;br&gt;+ refresh(refreshToken)   // /refresh&lt;br&gt;+ validate(token)   // /validate" vertex="1"><mxGeometry x="75" y="90" width="360" height="112" as="geometry"/></mxCell>
        <mxCell id="u5_svc" parent="1" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#5B9BD5;fontSize=11;" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;IAuthService&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ login(usuario, contraseña): TokenResponse&lt;br&gt;+ refresh(refreshToken): TokenResponse&lt;br&gt;+ validate(token): bool&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;Usuario y contraseña requeridos (no nulos ni en blanco).&lt;br&gt;La contraseña se compara contra el hash almacenado.&lt;br&gt;Login fallido → 401 «Usuario y/o contraseña incorrectos».&lt;br&gt;Login exitoso responde 201; refresh o token inválido, 401.&lt;br&gt;JWT de 5 min por defecto (parametrizable); el refresh token&lt;br&gt;dura más.&lt;/i&gt;" vertex="1"><mxGeometry x="75" y="247" width="360" height="217" as="geometry"/></mxCell>
        <mxCell id="u5_repo" parent="1" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF9E6;strokeColor=#BF9000;fontSize=11;" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;IAuthRepository&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ obtenerUsuario(nombreUsuario): Usuario&lt;br&gt;+ guardarRefreshToken(refreshToken)&lt;br&gt;+ obtenerRefreshToken(token): RefreshToken&lt;br&gt;+ revocarRefreshToken(token)" vertex="1"><mxGeometry x="75" y="509" width="360" height="128" as="geometry"/></mxCell>
        <mxCell id="u5_note" parent="1" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F2F2F2;strokeColor=#7F8C8D;fontSize=11;" value="&lt;b&gt;Entidades&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Usuario · Rol · RefreshToken" vertex="1"><mxGeometry x="75" y="667" width="360" height="67" as="geometry"/></mxCell>
        <mxCell id="u5_tok" parent="1" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#5B9BD5;fontSize=11;" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;ITokenService&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ generarJwt(usuario): string&lt;br&gt;+ generarRefreshToken(): string&lt;br&gt;+ validarJwt(token): bool" vertex="1"><mxGeometry x="535" y="227" width="270" height="113" as="geometry"/></mxCell>
