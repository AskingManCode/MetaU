        <mxCell id="edge_105" value="&amp;lt;&amp;lt;contains&amp;gt;&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;strokeColor=#3B82F6;strokeWidth=1.5;startArrow=diamond;startFill=1;startSize=10;endArrow=open;endSize=8;exitX=0.2647;exitY=1;exitDx=0;exitDy=0;entryX=0.8788;entryY=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="class_main_layout" target="class_sidebar">
