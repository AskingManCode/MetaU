        </mxCell>
        <mxCell id="class_auth_session" value="&lt;b&gt;&amp;lt;&amp;lt;Storage Manager&amp;gt;&amp;gt;&lt;br&gt;authSession (SessionStorage)&lt;/b&gt;&lt;hr&gt;+ access_token: string&lt;br&gt;+ refresh_token: string&lt;br&gt;+ expires_in: string&lt;br&gt;+ usuarioID: string&lt;br&gt;+ email: string&lt;br&gt;+ rememberMe: boolean&lt;hr&gt;+ saveAuthSession(session, remember): void&lt;br&gt;+ readAuthSession(): AuthSession | null&lt;br&gt;+ clearAuthSession(): void&lt;br&gt;+ hasActiveSession(): boolean" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FEF3C7;strokeColor=#D97706;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2200" y="228" width="380" height="250" as="geometry" />
        </mxCell>
        <mxCell id="class_api_client" value="&lt;b&gt;&amp;lt;&amp;lt;HTTP Client / Factory&amp;gt;&amp;gt;&lt;br&gt;createApi (Axios Interceptors)&lt;/b&gt;&lt;hr&gt;- instance: AxiosInstance&lt;br&gt;- baseURL: string&lt;br&gt;- isRefreshing: boolean&lt;hr&gt;+ requestInterceptor(config): RequestConfig&lt;br&gt;  &lt;i&gt;* Inyecta Bearer Token &amp;amp; X-Usuario-Id&lt;/i&gt;&lt;br&gt;+ responseInterceptor(response): Response&lt;br&gt;+ handle401Error(error): Promise&amp;lt;any&amp;gt;&lt;br&gt;  &lt;i&gt;* Refresh transparente vía authService&lt;/i&gt;&lt;br&gt;+ get / post / put / patch / delete()" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FEF3C7;strokeColor=#D97706;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2900" y="228" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="class_main_layout" value="&lt;b&gt;&amp;lt;&amp;lt;Layout Component&amp;gt;&amp;gt;&lt;br&gt;MainLayout&lt;/b&gt;&lt;hr&gt;+ sidebarCollapsed: boolean&lt;br&gt;+ userMenuOpen: boolean&lt;br&gt;+ currentBreadcrumbs: string[]&lt;hr&gt;+ toggleSidebar(): void&lt;br&gt;+ handleLogout(): void&lt;br&gt;+ renderHeader(): JSX.Element&lt;br&gt;+ renderFooter(): JSX.Element&lt;br&gt;+ renderOutlet(): JSX.Element" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#EFF6FF;strokeColor=#3B82F6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="870" y="548" width="340" height="220" as="geometry" />
        </mxCell>
        <mxCell id="class_hooks" value="&lt;b&gt;&amp;lt;&amp;lt;Custom React Hooks&amp;gt;&amp;gt;&lt;br&gt;useAuth, useListado &amp;amp; Dominio&lt;/b&gt;&lt;hr&gt;+ useAuth(): { user, status, login, logout, isAuthenticated }&lt;br&gt;+ useListado({ servicio, normalizar, nombre, listaCompleta }):&lt;br&gt;  - registros: T[], loading: boolean, totalRegistros: number&lt;br&gt;  - pagina: number, setPagina(p), recargar()&lt;br&gt;&lt;i&gt;Hooks de dominio:&lt;/i&gt; useUsuarios, useInstituciones, useCarreras,&lt;br&gt;useCursos, useGrupos, usePeriodos, useProfesores, useNotas,&lt;br&gt;useFacturas, usePagos, useListaEstudiantes, useBitacoras" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#E0E7FF;strokeColor=#6366F1;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1480" y="548" width="580" height="220" as="geometry" />
        </mxCell>
        <mxCell id="class_sidebar" value="&lt;b&gt;&amp;lt;&amp;lt;Navigation Component&amp;gt;&amp;gt;&lt;br&gt;Sidebar / SidebarSection / SidebarLink&lt;/b&gt;&lt;hr&gt;+ isCollapsed: boolean&lt;br&gt;+ menuSections: MenuSection[]&lt;br&gt;+ activeRoute: string&lt;hr&gt;+ filterByPermissions(roles: string[]): MenuSection[]&lt;br&gt;+ toggleSubmenu(sectionKey: string): void&lt;br&gt;+ handleNavigate(path: string): void&lt;br&gt;+ render(): JSX.Element" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#EFF6FF;strokeColor=#3B82F6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="670" y="838" width="330" height="200" as="geometry" />
        </mxCell>
        <mxCell id="class_page_header" value="&lt;b&gt;&amp;lt;&amp;lt;Header Component&amp;gt;&amp;gt;&lt;br&gt;MaintenanceHeader / PageHeader&lt;/b&gt;&lt;hr&gt;+ title: string&lt;br&gt;+ subtitle?: string&lt;br&gt;+ breadcrumbs: BreadcrumbItem[]&lt;br&gt;+ actions?: ActionButton[]&lt;hr&gt;+ onActionClick(actionType: string): void&lt;br&gt;+ render(): JSX.Element" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#EFF6FF;strokeColor=#3B82F6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1040" y="838" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="class_dto_summary" value="&lt;b&gt;&amp;lt;&amp;lt;DTOs &amp;amp; Modelos del Frontend&amp;gt;&amp;gt;&lt;/b&gt;&lt;hr&gt;• &lt;b&gt;USR:&lt;/b&gt; UserSession, UsuarioDto, RolDto, ParametroDto, ModuloDto&lt;br&gt;• &lt;b&gt;ACD:&lt;/b&gt; InstitucionDto, CarreraDto, CursoDto, GrupoDto, PeriodoDto, ProfesorDto&lt;br&gt;• &lt;b&gt;MAT:&lt;/b&gt; PrematriculaDto, MatriculaDto, ExpedienteDto, DireccionDto, NotaDto, RubroDto&lt;br&gt;• &lt;b&gt;IPN:&lt;/b&gt; FacturaDto, PagoDto, NotificacionDto, ComprobanteDto&lt;br&gt;• &lt;b&gt;GEN1:&lt;/b&gt; BitacoraDto (id, fecha, usuario, accion, jsonDetalle)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="270" y="1216" width="3260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="class_data_table" value="&lt;b&gt;&amp;lt;&amp;lt;Reusable Component&amp;gt;&amp;gt;&lt;br&gt;DataTable&amp;lt;T&amp;gt;&lt;/b&gt;&lt;hr&gt;+ data: T[]&lt;br&gt;+ columns: ColumnDef&amp;lt;T&amp;gt;[]&lt;br&gt;+ actions: ActionDef[] (ver, editar, eliminar, permisos)&lt;br&gt;+ pageSize: number = 15 (configurable)&lt;br&gt;+ serverPagination: boolean = false&lt;br&gt;+ currentPage / totalPages / totalRecords&lt;br&gt;+ loading: boolean&lt;hr&gt;+ cambiarPagina(nuevaPagina): void&lt;br&gt;+ ordenar(columnaKey): void&lt;br&gt;+ obtenerValor(registro, columna): any&lt;br&gt;+ render(): JSX.Element" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#8B5CF6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="300" y="1406" width="560" height="260" as="geometry" />
        </mxCell>
        <mxCell id="class_bitacora_modal" value="&lt;b&gt;&amp;lt;&amp;lt;Reusable Modal&amp;gt;&amp;gt;&lt;br&gt;BitacoraDetalle (JSON Inspector)&lt;/b&gt;&lt;hr&gt;+ isOpen: boolean&lt;br&gt;+ bitacoraItem: BitacoraDto | null&lt;hr&gt;+ formatJsonDiff(jsonDetalle: string): DiffView&lt;br&gt;+ onClose(): void&lt;br&gt;+ render(): JSX.Element" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#8B5CF6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="900" y="1406" width="500" height="260" as="geometry" />
        </mxCell>
        <mxCell id="class_confirm_dialog" value="&lt;b&gt;&amp;lt;&amp;lt;Reusable Modal&amp;gt;&amp;gt;&lt;br&gt;ConfirmDialog (Modal Sí/No)&lt;/b&gt;&lt;hr&gt;+ show: boolean&lt;br&gt;+ type: &amp;apos;warning&amp;apos;&lt;br&gt;+ message: string = &amp;quot;¿Desea eliminar / reversar...?&amp;quot;&lt;br&gt;+ onConfirm: () =&amp;gt; void&lt;br&gt;+ onCancel: () =&amp;gt; void&lt;hr&gt;&lt;i&gt;* Implementado en Notification.jsx mediante&lt;br&gt;type=&amp;apos;warning&amp;apos; con handlers onConfirm/onCancel&lt;br&gt;para acciones críticas destructivas.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#8B5CF6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1406" width="520" height="260" as="geometry" />
        </mxCell>
        <mxCell id="class_export_buttons" value="&lt;b&gt;&amp;lt;&amp;lt;Reusable Component&amp;gt;&amp;gt;&lt;br&gt;ExportButtons (CSV &amp;amp; PDF)&lt;/b&gt;&lt;hr&gt;+ onExportCsv: () =&amp;gt; void&lt;br&gt;+ onExportPdf: () =&amp;gt; void&lt;br&gt;+ loading: boolean&lt;br&gt;+ disabled?: boolean&lt;hr&gt;+ handleCsvDownload(): void&lt;br&gt;+ handlePdfDownload(): void&lt;br&gt;+ render(): JSX.Element" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#8B5CF6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2000" y="1406" width="440" height="260" as="geometry" />
        </mxCell>
        <mxCell id="class_notification_toast" value="&lt;b&gt;&amp;lt;&amp;lt;UI Feedback Component&amp;gt;&amp;gt;&lt;br&gt;Notification (Toast / Alert)&lt;/b&gt;&lt;hr&gt;+ type: &amp;apos;success&amp;apos; | &amp;apos;error&amp;apos; | &amp;apos;warning&amp;apos; | &amp;apos;info&amp;apos;&lt;br&gt;+ message: string&lt;br&gt;+ show: boolean = true&lt;br&gt;+ autoCloseMs: number = 4000&lt;br&gt;+ onClose: () =&amp;gt; void&lt;hr&gt;+ render(): JSX.Element&lt;br&gt;&lt;i&gt;Iconos dinámicos Bootstrap Icons según variant.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#8B5CF6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2480" y="1406" width="520" height="260" as="geometry" />
        </mxCell>
        <mxCell id="view_auth_profile" value="&lt;b&gt;&amp;lt;&amp;lt;View Components&amp;gt;&amp;gt;&lt;br&gt;Login, Dashboard &amp;amp; Perfil&lt;/b&gt;&lt;hr&gt;&lt;b&gt;ADM2 — Login&lt;/b&gt; (email, password, rememberMe)&lt;br&gt;&lt;b&gt;ADM3 — Dashboard&lt;/b&gt; (métricas, accesos directos)&lt;br&gt;&lt;b&gt;ADM24 — MiPerfil&lt;/b&gt; (datos personales, cambiar password)&lt;hr&gt;+ handleLoginSubmit(): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ handleChangePassword(): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ render(): JSX.Element" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="270" y="1844" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="view_sistema_usr" value="&lt;b&gt;&amp;lt;&amp;lt;View Components: Sistema&amp;gt;&amp;gt;&lt;br&gt;Usuarios, Roles, Módulos, Parámetros &amp;amp; Bitácoras&lt;/b&gt;&lt;hr&gt;&lt;b&gt;ADM4 — Usuarios&lt;/b&gt; (CRUD, cambiar estado Activo/Inactivo)&lt;br&gt;&lt;b&gt;ADM5 — Roles&lt;/b&gt; (CRUD y matriz de permisos por módulo)&lt;br&gt;&lt;b&gt;ADM6 — Parámetros&lt;/b&gt; (CRUD paginado, valores vigencia JWT)&lt;br&gt;&lt;b&gt;ADM7 — Módulos Menú&lt;/b&gt; (orden y asignación por rol)&lt;br&gt;&lt;b&gt;ADM23 — Bitácoras&lt;/b&gt; (visor de auditoría con diff JSON)&lt;hr&gt;+ onCrear / onEditar / onEliminar()&lt;br&gt;+ onGuardarPermisos(rolId, permisos): void" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="720" y="1844" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="view_oferta_acd" value="&lt;b&gt;&amp;lt;&amp;lt;View Components: Oferta Académica&amp;gt;&amp;gt;&lt;br&gt;Instituciones, Carreras, Cursos, Periodos &amp;amp; Grupos&lt;/b&gt;&lt;hr&gt;&lt;b&gt;ADM8 — Instituciones&lt;/b&gt; (búsqueda y CRUD)&lt;br&gt;&lt;b&gt;ADM9 — Carreras&lt;/b&gt; (por institución, director de carrera)&lt;br&gt;&lt;b&gt;ADM10 — Cursos&lt;/b&gt; (filtro carrera, créditos, nivel)&lt;br&gt;&lt;b&gt;ADM11 — Profesores&lt;/b&gt; (ABM, validación mayoría de edad)&lt;br&gt;&lt;b&gt;ADM12 — Periodos&lt;/b&gt; (estados futuro / activo / cerrado)&lt;br&gt;&lt;b&gt;ADM13 — Grupos&lt;/b&gt; (por curso y periodo, cupos y horarios)&lt;hr&gt;+ handleFilterChange() | onSaveEntity()" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1250" y="1844" width="460" height="200" as="geometry" />
        </mxCell>
        <mxCell id="view_reportes_academicos" value="&lt;b&gt;&amp;lt;&amp;lt;View Components: Reportes Académicos&amp;gt;&amp;gt;&lt;br&gt;Historial Académico &amp;amp; Listados de Estudiantes&lt;/b&gt;&lt;hr&gt;&lt;b&gt;ADM18 — Promedios e Historial por Estudiante&lt;/b&gt;&lt;br&gt;  - Consulta de kardex, materias aprobadas y ponderado&lt;br&gt;&lt;b&gt;ADM19 — Listados de Estudiantes por Periodo&lt;/b&gt;&lt;br&gt;  - Filtro por periodo, carrera y curso&lt;hr&gt;+ onExportarPDF(): void&lt;br&gt;+ onExportarCSV(): void" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1760" y="1844" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="view_matricula_mat" value="&lt;b&gt;&amp;lt;&amp;lt;View Components: Matrícula &amp;amp; Expedientes&amp;gt;&amp;gt;&lt;br&gt;Prematrícula, Matrícula, Expedientes &amp;amp; Direcciones&lt;/b&gt;&lt;hr&gt;&lt;b&gt;ADM14 — Prematrículas&lt;/b&gt; (exclusivo para periodos futuros)&lt;br&gt;&lt;b&gt;ADM15 — Matrícula&lt;/b&gt; (asignación estudiante → curso → grupo)&lt;br&gt;&lt;b&gt;ADM16 — Expedientes&lt;/b&gt; (datos personales, dirección cascada CR)&lt;br&gt;&lt;b&gt;ADM17 — Desglose y Notas&lt;/b&gt; (rubros 100%, registro notas 1-100)&lt;hr&gt;+ onSeleccionarProvincia / Canton / Distrito()&lt;br&gt;+ onRegistrarNotas() | onConfirmarPrematricula()" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2230" y="1844" width="470" height="200" as="geometry" />
        </mxCell>
        <mxCell id="view_finanzas_ipn" value="&lt;b&gt;&amp;lt;&amp;lt;View Components: Finanzas &amp;amp; Notificaciones&amp;gt;&amp;gt;&lt;br&gt;Facturación, Pagos &amp;amp; Notificaciones por Correo&lt;/b&gt;&lt;hr&gt;&lt;b&gt;ADM20 — Facturas&lt;/b&gt; (generación base 30k + 2%, anulación)&lt;br&gt;&lt;b&gt;ADM21 — Pagos&lt;/b&gt; (registro de pago y reversión con motivo)&lt;br&gt;&lt;b&gt;ADM22 — Notificaciones&lt;/b&gt; (envío individual/múltiple, historial)&lt;hr&gt;+ onGenerarFactura() | onAnularFactura()&lt;br&gt;+ onRegistrarPago() | onEnviarCorreo()" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2750" y="1844" width="460" height="200" as="geometry" />
        </mxCell>
        <mxCell id="note_screen_pattern" value="&lt;b&gt;Patrón Estándar de Mantenimientos (CRUD):&lt;/b&gt;&lt;br&gt;1. Listado paginado con búsqueda y ordenamiento (DataTable).&lt;br&gt;2. Formulario de creación/edición con validación Zod / Bootstrap.&lt;br&gt;3. Eliminación con modal de confirmación (ConfirmDialog).&lt;br&gt;4. Auditoría automática registrada en GEN1 (/bitacora)." style="shape=note;size=14;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;align=left;spacingLeft=10;fontSize=12;whiteSpace=wrap;verticalAlign=top;spacingTop=6;spacingRight=10;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="3250" y="1844" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="svc_gen1_group" value="&lt;b&gt;&amp;lt;&amp;lt;API Services: GEN1 Client&amp;gt;&amp;gt;&lt;br&gt;Servicio de Bitácoras y Auditoría Transversal&lt;/b&gt;&lt;hr&gt;&lt;b&gt;bitacoraService:&lt;/b&gt;&lt;br&gt;+ getAll(): Promise&amp;lt;BitacoraDto[]&amp;gt;&lt;br&gt;+ getPage(pagina = 1): Promise&amp;lt;PaginatedResponse&amp;lt;BitacoraDto&amp;gt;&amp;gt;&lt;br&gt;+ create(data: BitacoraCreateDto): Promise&amp;lt;void&amp;gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Invocado tanto desde la pantalla ADM23 como de forma transversal por los módulos del frontend al registrar eventos de usuario y auditoría.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFFBEB;strokeColor=#F59E0B;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="270" y="2222" width="400" height="330" as="geometry" />
        </mxCell>
        <mxCell id="svc_usr_group" value="&lt;b&gt;&amp;lt;&amp;lt;API Services: USR* Client&amp;gt;&amp;gt;&lt;br&gt;Servicios de Autenticación, Usuarios y Sistema&lt;/b&gt;&lt;hr&gt;&lt;b&gt;authService:&lt;/b&gt;&lt;br&gt;+ login(user, pass): Promise&amp;lt;TokenResponse&amp;gt;&lt;br&gt;+ refresh(token): Promise&amp;lt;TokenResponse&amp;gt;&lt;br&gt;+ validate(token): Promise&amp;lt;boolean&amp;gt;&lt;br&gt;&lt;b&gt;authAuditService:&lt;/b&gt;&lt;br&gt;+ recordAuthAudit(desc, session): Promise&amp;lt;void&amp;gt;&lt;br&gt;&lt;b&gt;usuarioService:&lt;/b&gt;&lt;br&gt;+ getAll(params) / getByEmail() / create() / update() / delete()&lt;br&gt;&lt;b&gt;rolService:&lt;/b&gt;&lt;br&gt;+ getAll() / getById() / create() / update() / getPermisos() / asignarPermisos()&lt;br&gt;&lt;b&gt;parametroService:&lt;/b&gt;&lt;br&gt;+ getAll() / getByCodigo() / create() / update()&lt;br&gt;&lt;b&gt;moduloService:&lt;/b&gt;&lt;br&gt;+ getAll() / getById() / create() / update() / delete()&lt;br&gt;&lt;b&gt;miPerfilService:&lt;/b&gt;&lt;br&gt;+ getPerfil() / updatePerfil() / cambiarPassword()" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFFBEB;strokeColor=#F59E0B;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="800" y="2222" width="530" height="330" as="geometry" />
        </mxCell>
        <mxCell id="svc_acd_group" value="&lt;b&gt;&amp;lt;&amp;lt;API Services: ACD* Client&amp;gt;&amp;gt;&lt;br&gt;Servicios de Oferta Académica y Reportes&lt;/b&gt;&lt;hr&gt;&lt;b&gt;institucionService:&lt;/b&gt; getAll(), getById(), create(), update(), delete()&lt;br&gt;&lt;b&gt;carreraService:&lt;/b&gt; getAll(params), getByCodigo(), create(), update()&lt;br&gt;&lt;b&gt;cursoService:&lt;/b&gt; getAll(params), getByCodigo(), create(), update()&lt;br&gt;&lt;b&gt;grupoService:&lt;/b&gt; getAll(params), getByCodigo(), create(), update()&lt;br&gt;&lt;b&gt;periodoService:&lt;/b&gt; getAll(), getById(), create(), update(), cambiarEstado()&lt;br&gt;&lt;b&gt;profesorService:&lt;/b&gt; getAll(params), getById(), create(), update()&lt;br&gt;&lt;b&gt;historialAcademicoService:&lt;/b&gt;&lt;br&gt;+ getByEstudiante(id): Promise&amp;lt;HistorialDto&amp;gt;&lt;br&gt;+ exportPdf(id): Promise&amp;lt;Blob&amp;gt;&lt;br&gt;&lt;b&gt;listaEstudiantesService:&lt;/b&gt;&lt;br&gt;+ getByPeriodo(periodoId, cursoCode?): Promise&amp;lt;EstudianteListaDto[]&amp;gt;&lt;br&gt;+ exportCsv(params) / exportPdf(params): Promise&amp;lt;Blob&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFFBEB;strokeColor=#F59E0B;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1370" y="2222" width="710" height="330" as="geometry" />
        </mxCell>
        <mxCell id="svc_mat_group" value="&lt;b&gt;&amp;lt;&amp;lt;API Services: MAT* Client&amp;gt;&amp;gt;&lt;br&gt;Servicios de Matrícula, Expedientes y Calificaciones&lt;/b&gt;&lt;hr&gt;&lt;b&gt;prematriculaService:&lt;/b&gt;&lt;br&gt;+ getAll(params) / getById() / create() / update() / confirmar()&lt;br&gt;&lt;b&gt;matriculaService:&lt;/b&gt;&lt;br&gt;+ getAll(params) / create() / update() / delete()&lt;br&gt;&lt;b&gt;expedienteService:&lt;/b&gt;&lt;br&gt;+ getAll(params) / getByIdentificacion() / create() / update()&lt;br&gt;&lt;b&gt;direccionService:&lt;/b&gt;&lt;br&gt;+ getProvincias(): Promise&amp;lt;ProvinciaDto[]&amp;gt;&lt;br&gt;+ getCantones(provinciaId): Promise&amp;lt;CantonDto[]&amp;gt;&lt;br&gt;+ getDistritos(cantonId): Promise&amp;lt;DistritoDto[]&amp;gt;&lt;br&gt;&lt;b&gt;notaService:&lt;/b&gt;&lt;br&gt;+ getNotasByGrupo(grupoCode): Promise&amp;lt;NotaEstudianteDto[]&amp;gt;&lt;br&gt;+ getRubrosByGrupo(grupoCode): Promise&amp;lt;RubroDto[]&amp;gt;&lt;br&gt;+ saveRubros(grupoCode, rubros): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ saveNotas(grupoCode, notas): Promise&amp;lt;void&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFFBEB;strokeColor=#F59E0B;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2120" y="2222" width="560" height="330" as="geometry" />
        </mxCell>
        <mxCell id="svc_ipn_group" value="&lt;b&gt;&amp;lt;&amp;lt;API Services: IPN* Client&amp;gt;&amp;gt;&lt;br&gt;Servicios de Facturación, Pagos y Notificaciones&lt;/b&gt;&lt;hr&gt;&lt;b&gt;facturaService:&lt;/b&gt;&lt;br&gt;+ getById(facturaId): Promise&amp;lt;FacturaDto&amp;gt;&lt;br&gt;+ getByPeriodo(periodoId): Promise&amp;lt;FacturaDto[]&amp;gt;&lt;br&gt;+ create(data): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ anular(facturaId, payload): Promise&amp;lt;void&amp;gt;&lt;br&gt;&lt;b&gt;pagoService:&lt;/b&gt;&lt;br&gt;+ getById(pagoId): Promise&amp;lt;PagoDto&amp;gt;&lt;br&gt;+ create(data): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ reversar(pagoId, payload): Promise&amp;lt;void&amp;gt;&lt;br&gt;&lt;b&gt;notificacionService:&lt;/b&gt;&lt;br&gt;+ getAll(): Promise&amp;lt;NotificacionDto[]&amp;gt;&lt;br&gt;+ getPage(pagina): Promise&amp;lt;PaginatedResponse&amp;lt;NotificacionDto&amp;gt;&amp;gt;&lt;br&gt;+ getById(id): Promise&amp;lt;NotificacionDto&amp;gt;&lt;br&gt;+ enviar(data): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ enviarMultiple(data): Promise&amp;lt;void&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFFBEB;strokeColor=#F59E0B;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2720" y="2222" width="520" height="330" as="geometry" />
        </mxCell>
        <mxCell id="note_interceptor_wiring" value="&lt;b&gt;Seguridad y Transporte HTTP:&lt;/b&gt;&lt;br&gt;• Todos los servicios consumen &lt;code&gt;createApi(VITE_URL_*)&lt;/code&gt;.&lt;br&gt;• El interceptor inyecta en cada solicitud:&lt;br&gt;  - &lt;code&gt;Authorization: Bearer &amp;lt;token&amp;gt;&lt;/code&gt;&lt;br&gt;  - &lt;code&gt;X-Usuario-Id / UsuarioGUID&lt;/code&gt;&lt;br&gt;• Si la API responde 401 Unauthorized, interceptor refresca automáticamente el token vía &lt;code&gt;/refresh&lt;/code&gt; y reintenta la petición original." style="shape=note;size=14;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;align=left;spacingLeft=10;fontSize=12;whiteSpace=wrap;verticalAlign=top;spacingTop=6;spacingRight=10;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="3280" y="2222" width="250" height="330" as="geometry" />
        </mxCell>
        <mxCell id="ms_gen1" value="&lt;b&gt;&amp;lt;&amp;lt;Microservicio Backend&amp;gt;&amp;gt;&lt;br&gt;GEN1 — Bitácoras y Auditoría Transversal&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Microservicio integrado:&lt;/b&gt;&lt;br&gt;• GEN1 (Bitácora del Sistema)&lt;hr&gt;&lt;b&gt;Endpoints públicos expuestos:&lt;/b&gt;&lt;br&gt;• GET /bitacora (listado paginado por filtro)&lt;br&gt;• POST /bitacora (registro de auditoría de acciones CRUD,&lt;br&gt;  cambios de estado y excepciones de usuario)&lt;br&gt;&lt;font color='#888888'&gt;&lt;i&gt;(Clases internas detalladas en diagrama GEN1)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFE4E6;strokeColor=#E11D48;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="270" y="2730" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ms_usr" value="&lt;b&gt;&amp;lt;&amp;lt;Microservicio Backend&amp;gt;&amp;gt;&lt;br&gt;USR* — Gestión de Identidad, Accesos y Parámetros&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Microservicios integrados:&lt;/b&gt;&lt;br&gt;• USR1 (Usuarios) · USR2 (Roles) · USR3 (Parámetros)&lt;br&gt;• USR4 (Módulos) · USR5 (Login &amp;amp; JWT)&lt;hr&gt;&lt;b&gt;Endpoints públicos expuestos:&lt;/b&gt;&lt;br&gt;• POST /login, POST /refresh, POST /validate&lt;br&gt;• GET/POST/PUT/DELETE /usuario&lt;br&gt;• GET/POST/PUT/DELETE /rol, POST /rol/permisos&lt;br&gt;• GET/POST/PUT /parametro&lt;br&gt;• GET/POST/PUT/DELETE /modulo&lt;br&gt;&lt;font color='#888888'&gt;&lt;i&gt;(Clases internas detalladas en diagramas USR1-USR5)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFE4E6;strokeColor=#E11D48;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="800" y="2730" width="530" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ms_acd" value="&lt;b&gt;&amp;lt;&amp;lt;Microservicio Backend&amp;gt;&amp;gt;&lt;br&gt;ACD* — Oferta y Gestión Académica&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Microservicios integrados:&lt;/b&gt;&lt;br&gt;• ACD1 (Instituciones) · ACD2 (Carreras) · ACD3 (Cursos)&lt;br&gt;• ACD4 (Grupos) · ACD5 (Periodos) · ACD6 (Profesores)&lt;br&gt;• ACA1 (Historial Académico) · ACA2 (Listado Estudiantes)&lt;hr&gt;&lt;b&gt;Endpoints públicos expuestos:&lt;/b&gt;&lt;br&gt;• GET/POST/PUT/DELETE /institucion&lt;br&gt;• GET/POST/PUT /carrera | /curso | /grupo | /profesor&lt;br&gt;• GET/POST/PUT /periodo, PATCH /periodo/estado&lt;br&gt;• GET /historialacademico/{id}, GET /listadoestudiantes&lt;br&gt;&lt;font color='#888888'&gt;&lt;i&gt;(Clases internas detalladas en diagramas ACD1-ACD6)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFE4E6;strokeColor=#E11D48;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1370" y="2730" width="710" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ms_mat" value="&lt;b&gt;&amp;lt;&amp;lt;Microservicio Backend&amp;gt;&amp;gt;&lt;br&gt;MAT* — Matrícula, Expedientes y Evaluación&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Microservicios integrados:&lt;/b&gt;&lt;br&gt;• MAT1 (Pre-Matrícula) · MAT2 (Matrícula) · MAT3 (Expedientes)&lt;br&gt;• MAT4 (Direcciones Geográficas) · MAT5 (Notas &amp;amp; Rubros)&lt;hr&gt;&lt;b&gt;Endpoints públicos expuestos:&lt;/b&gt;&lt;br&gt;• GET/POST/PUT /prematricula, POST /prematricula/confirmar&lt;br&gt;• GET/POST/PUT/DELETE /matricula&lt;br&gt;• GET/POST/PUT /expediente&lt;br&gt;• GET /direcciones/provincias | cantones | distritos&lt;br&gt;• GET/POST/PUT /notas, GET/POST /rubros&lt;br&gt;&lt;font color='#888888'&gt;&lt;i&gt;(Clases internas detalladas en diagramas MAT1-MAT5)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFE4E6;strokeColor=#E11D48;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2120" y="2730" width="560" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ms_ipn" value="&lt;b&gt;&amp;lt;&amp;lt;Microservicio Backend&amp;gt;&amp;gt;&lt;br&gt;IPN* — Finanzas, Pagos y Notificaciones&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Microservicios integrados:&lt;/b&gt;&lt;br&gt;• IPN1 (Facturación) · IPN2 (Pagos)&lt;br&gt;• IPN3 (Gestión de Notificaciones por Correo)&lt;hr&gt;&lt;b&gt;Endpoints públicos expuestos:&lt;/b&gt;&lt;br&gt;• GET/POST /api/factura, PATCH /api/factura/{id} (anular)&lt;br&gt;• GET/POST /pago, PATCH /pago/{id} (reversar)&lt;br&gt;• GET/POST /api/notificar, POST /api/notificar/multiple&lt;br&gt;• GET /api/notificar/{id} (historial de correos)&lt;br&gt;&lt;font color='#888888'&gt;&lt;i&gt;(Clases internas detalladas en diagramas IPN1-IPN3)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFE4E6;strokeColor=#E11D48;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="2720" y="2730" width="520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="box_legend" value="&lt;b&gt;Criterios de Aceptación y Leyenda UML:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Muestra dependencias sin detallar clases internas:&lt;/b&gt; Cada bloque representa la interfaz del subsistema microservicio (contrato HTTP REST / JSON).&lt;br&gt;• &lt;b&gt;Componentes del Frontend:&lt;/b&gt; React Router (App), Layout (MainLayout, Sidebar, MaintenanceHeader), AuthContext, custom hooks, reusable components (DataTable, Modals).&lt;br&gt;• &lt;b&gt;Servicios API:&lt;/b&gt; Cliente Axios modularizado por dominio de microservicio con inyección de JWT y reintento transparente ante 401.&lt;br&gt;• &lt;b&gt;Formato editable:&lt;/b&gt; Archivo nativo .drawio con geometría limpia y capas desacopladas." style="shape=note;size=14;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;align=left;spacingLeft=10;fontSize=12;whiteSpace=wrap;verticalAlign=top;spacingTop=6;spacingRight=10;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="240" y="3080" width="3320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="edge_100" value="&amp;lt;&amp;lt;renders&amp;gt;&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;strokeColor=#3B82F6;strokeWidth=1.5;dashed=1;endArrow=open;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="class_app" target="class_protected_route">
