        <mxCell id="class_auth_context" value="&lt;b&gt;&amp;lt;&amp;lt;React Context&amp;gt;&amp;gt;&lt;br&gt;AuthContext / AuthProvider&lt;/b&gt;&lt;hr&gt;+ user: UserSession | null&lt;br&gt;+ token: string | null&lt;br&gt;+ isAuthenticated: boolean&lt;br&gt;+ loading: boolean&lt;hr&gt;+ login(email, contrasena, rememberMe): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ logout(): void&lt;br&gt;+ refresh(): Promise&amp;lt;AuthSession&amp;gt;&lt;br&gt;+ hasRole(roleName: string): boolean&lt;br&gt;+ getMenuFiltered(): MenuItem[]" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#DBEAFE;strokeColor=#2563EB;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
