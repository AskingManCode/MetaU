        <mxCell id="class_protected_route" value="&lt;b&gt;&amp;lt;&amp;lt;React Component&amp;gt;&amp;gt;&lt;br&gt;ProtectedRoute&lt;/b&gt;&lt;hr&gt;+ children: ReactNode&lt;br&gt;+ allowedRoles?: string[]&lt;hr&gt;+ validateSession(): boolean&lt;br&gt;+ render(): JSX.Element" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#EFF6FF;strokeColor=#3B82F6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;spacingRight=10;arcSize=4;fontColor=#1F2937;" vertex="1" parent="1">
