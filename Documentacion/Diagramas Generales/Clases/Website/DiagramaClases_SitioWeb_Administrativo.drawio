          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_104" value="&amp;lt;&amp;lt;configures interceptor&amp;gt;&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;strokeColor=#D97706;strokeWidth=1.5;dashed=1;endArrow=open;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="class_auth_session" target="class_api_client">
