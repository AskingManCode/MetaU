        <mxCell id="title_banner" value="&lt;b&gt;SISTEMA WEB ADMINISTRATIVO (REACT) — DIAGRAMA GENERAL DE CLASES&lt;/b&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;Arquitectura Frontend, Componentes UI, Manejo de Sesión, Servicios de API y Dependencias hacia Microservicios (USR*, ACD*, MAT*, IPN*, GEN1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#0D233A;fontColor=#FFFFFF;fontSize=20;align=left;spacingLeft=25;shadow=1;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
