        <mxCell id="appMovil" value="&lt;b&gt;App Movil Flutter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Android / iOS - no sujeta a CORS&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="zClientes">
