        </mxCell>
        <mxCell id="kestrel" value="&lt;b&gt;1. Kestrel - Puerto unico&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;HTTP :5000 / HTTPS :5001&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="zGateway">
