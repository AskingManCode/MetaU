        <!-- ===================== LEYENDA Y CRITERIOS ===================== -->
        <mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;━━━  Flujo de peticiones a traves del Gateway&lt;br&gt;- - - -  Dependencia de alto nivel o fuera del alcance del Gateway&lt;br&gt;&lt;font color='#2D7D46'&gt;[VERBOS]&lt;/font&gt;  Metodos HTTP permitidos por ruta (otros verbos = 405)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="815" width="560" height="95" as="geometry" />
        </mxCell>
        <mxCell id="criterios" value="&lt;b&gt;Criterios de aceptacion GTW1 representados&lt;/b&gt;&lt;br&gt;1. Puerto unico de entrada (:5000 / :5001)&lt;br&gt;2. Routing hacia 20 microservicios internos&lt;br&gt;3. Verbos REST controlados por ruta&lt;br&gt;4. Prefijos auth, admin, academic, enrollment, grades, finance, location, notifications&lt;br&gt;5. CORS para el cliente Flutter Web" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F6FBF5;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="815" width="560" height="95" as="geometry" />
        </mxCell>

