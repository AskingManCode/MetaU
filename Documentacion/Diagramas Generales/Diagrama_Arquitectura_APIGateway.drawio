          <mxGeometry x="20" y="550" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- ===================== ZONA 2: API GATEWAY ===================== -->
        <mxCell id="zGateway" value="CAPA PERIMETRAL - ApiGateway (.NET 10 + Minimal APIs + YARP 2.3.0)" style="swimlane;startSize=34;html=1;rounded=1;arcSize=3;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#F6FBF5;fontStyle=1;fontSize=12;fontColor=#2D5A27;" vertex="1" parent="1">
