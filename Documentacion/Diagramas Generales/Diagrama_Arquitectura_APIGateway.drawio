        <mxCell id="cors" value="&lt;b&gt;2. Middleware CORS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;GatewayCorsPolicy - Cors:AllowedOrigins&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="zGateway">
